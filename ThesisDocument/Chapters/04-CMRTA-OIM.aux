\newlabel{tab:feasibility-check}{{5.2}{29}{\textbf {Feasibility Check Table.} For all robot coalitions and both tasks, determine which (coalition, task) pairs are feasible (combined capabilities $\geq $ requirements)}{table.caption.18}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5.3}{\ignorespaces \textbf  {Utility Calculation Table.} For each feasible (coalition, task) pair: compute excess ($\|\mathbf  {c}_S - \mathbf  {q}_j\|$), efficiency $\phi = \exp (-0.5 \cdot \text  {excess})$, and utility $U(S, t_j) = V_j \cdot \phi - \text  {cost}$. Not all entries need costs in this simplified example.}}{29}{table.caption.19}\protected@file@percent }
\newlabel{tab:utility-table}{{5.3}{29}{\textbf {Utility Calculation Table.} For each feasible (coalition, task) pair: compute excess ($\|\mathbf {c}_S - \mathbf {q}_j\|$), efficiency $\phi = \exp (-0.5 \cdot \text {excess})$, and utility $U(S, t_j) = V_j \cdot \phi - \text {cost}$. Not all entries need costs in this simplified example}{table.caption.19}{}}
\@writefile{toc}{\contentsline {section}{\numberline {5.3}From MRTA to Maximum Weight Independent Set}{29}{section.5.3}\protected@file@percent }
\newlabel{sec:mwis-mapping}{{5.3}{29}{From MRTA to Maximum Weight Independent Set}{tcb@cnt@block.5.3.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.2}{\ignorespaces  \textbf  {Conflict Graph --- 7-Node Worked Example.} Each node represents a feasible (coalition, task) pair with size proportional to utility weight. Red edges indicate robot conflicts; blue edges indicate task conflicts. The maximum weight independent set is $\{v_0, v_1\}$ (shown highlighted), corresponding to allocation $(r_1 \to t_2, r_3 \to t_1)$ with total utility $5.0 + 6.0 = 11.0$. }}{30}{figure.caption.20}\protected@file@percent }
\newlabel{fig:conflict-graph}{{5.2}{30}{\textbf {Conflict Graph --- 7-Node Worked Example.} Each node represents a feasible (coalition, task) pair with size proportional to utility weight. Red edges indicate robot conflicts; blue edges indicate task conflicts. The maximum weight independent set is $\{v_0, v_1\}$ (shown highlighted), corresponding to allocation $(r_1 \to t_2, r_3 \to t_1)$ with total utility $5.0 + 6.0 = 11.0$}{figure.caption.20}{}}
\newlabel{lem:mrta-mwis}{{5.3}{30}{From MRTA to Maximum Weight Independent Set}{figure.caption.20}{}}
