\@writefile{lof}{\contentsline {figure}{\numberline {5.3}{\ignorespaces  \textbf  {OIM Phase Trajectories --- Worked Example.} Each colored line shows one oscillator's phase over time. Initially, phases are random. Coupling drives them toward either 0 or $\pi $ (binarized states). By $t \approx 100$ ms, phases have stabilized, revealing the solution $s = [+1, +1, -1, -1, -1]^T$, corresponding to selecting nodes $v_0, v_1$. }}{35}{figure.caption.23}\protected@file@percent }
\newlabel{fig:oim-trajectories}{{5.3}{35}{\textbf {OIM Phase Trajectories --- Worked Example.} Each colored line shows one oscillator's phase over time. Initially, phases are random. Coupling drives them toward either 0 or $\pi $ (binarized states). By $t \approx 100$ ms, phases have stabilized, revealing the solution $s = [+1, +1, -1, -1, -1]^T$, corresponding to selecting nodes $v_0, v_1$}{figure.caption.23}{}}
