\@writefile{lot}{\contentsline {table}{\numberline {9.1}{\ignorespaces \textbf  {Table 2.1: Hardware Platforms for Optimization.} Comparison of existing and emerging architectures for solving combinatorial optimization problems. Neuromorphic platforms (OIM, Loihi) offer sub-millisecond latency with energy efficiency advantages.}}{84}{table.caption.45}\protected@file@percent }
\newlabel{tab:2-1}{{9.1}{84}{\textbf {Table 2.1: Hardware Platforms for Optimization.} Comparison of existing and emerging architectures for solving combinatorial optimization problems. Neuromorphic platforms (OIM, Loihi) offer sub-millisecond latency with energy efficiency advantages}{table.caption.45}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9.2}{\ignorespaces \textbf  {Table 4.1: 3-Robot 2-Task MRTA Setup.} Robot capability vectors and task requirement vectors for the worked example. Robot 0 excels at capability type 1, Robot 1 at type 2, Robot 2 is balanced.}}{84}{table.caption.46}\protected@file@percent }
\newlabel{tab:4-1}{{9.2}{84}{\textbf {Table 4.1: 3-Robot 2-Task MRTA Setup.} Robot capability vectors and task requirement vectors for the worked example. Robot 0 excels at capability type 1, Robot 1 at type 2, Robot 2 is balanced}{table.caption.46}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9.3}{\ignorespaces \textbf  {Table 4.2: Coalition-Task Feasibility.} Seven coalition-task nodes with utility values. Node 0 (robot 2 for task 0) achieves maximum utility 5.2094. Conflict graph edges (18 total) eliminate infeasible combinations.}}{84}{table.caption.47}\protected@file@percent }
\newlabel{tab:4-2}{{9.3}{84}{\textbf {Table 4.2: Coalition-Task Feasibility.} Seven coalition-task nodes with utility values. Node 0 (robot 2 for task 0) achieves maximum utility 5.2094. Conflict graph edges (18 total) eliminate infeasible combinations}{table.caption.47}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9.4}{\ignorespaces \textbf  {Table 4.3: Conflict Graph Edges (Sample).} Conflict edges enforce mutual exclusivity. Task conflicts prevent different coalitions serving same task. Robot conflicts prevent robot reuse. Both-type edges occur when coalitions share robots and task.}}{85}{table.caption.48}\protected@file@percent }
\newlabel{tab:4-3}{{9.4}{85}{\textbf {Table 4.3: Conflict Graph Edges (Sample).} Conflict edges enforce mutual exclusivity. Task conflicts prevent different coalitions serving same task. Robot conflicts prevent robot reuse. Both-type edges occur when coalitions share robots and task}{table.caption.48}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9.5}{\ignorespaces \textbf  {Table 4.4: Penalty Parameter Bounds.} Penalty coefficient $\lambda = 8.0$ exceeds minimum theoretical bound $\lambda _{\min } = 7.7952$, ensuring conflict constraints are properly encoded in QUBO penalty term.}}{85}{table.caption.49}\protected@file@percent }
\newlabel{tab:4-4}{{9.5}{85}{\textbf {Table 4.4: Penalty Parameter Bounds.} Penalty coefficient $\lambda = 8.0$ exceeds minimum theoretical bound $\lambda _{\min } = 7.7952$, ensuring conflict constraints are properly encoded in QUBO penalty term}{table.caption.49}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9.6}{\ignorespaces \textbf  {Table 4.5: Optimal Allocation Solution.} The MWIS solution selects nodes $\{0, 4\}$ (robot 2 for task 0, robot 0 for task 1), yielding total utility $U^{\text  {opt}} = 9.1787$. Feasibility verified for both tasks.}}{85}{table.caption.50}\protected@file@percent }
\newlabel{tab:4-5}{{9.6}{85}{\textbf {Table 4.5: Optimal Allocation Solution.} The MWIS solution selects nodes $\{0, 4\}$ (robot 2 for task 0, robot 0 for task 1), yielding total utility $U^{\text {opt}} = 9.1787$. Feasibility verified for both tasks}{table.caption.50}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9.7}{\ignorespaces \textbf  {Table 4.6: QUBO Matrix Structure.} QUBO matrix $\mathbf  {Q} = \mathbf  {W} - \lambda \mathbf  {P}$ where diagonal elements $W_{ii}$ are coalition utilities and off-diagonal $P_{ij}$ encode conflict edges. Penalty $\lambda = 8.0$ weights conflict constraints.}}{86}{table.caption.51}\protected@file@percent }
\newlabel{tab:4-6}{{9.7}{86}{\textbf {Table 4.6: QUBO Matrix Structure.} QUBO matrix $\mathbf {Q} = \mathbf {W} - \lambda \mathbf {P}$ where diagonal elements $W_{ii}$ are coalition utilities and off-diagonal $P_{ij}$ encode conflict edges. Penalty $\lambda = 8.0$ weights conflict constraints}{table.caption.51}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9.8}{\ignorespaces \textbf  {Table 4.7: Scalability Analysis.} Problem size grows combinatorially: 3 robots + 2 tasks = 7 MWIS nodes, 18 conflict edges. OIM hardware depth scales linearly with spin count. QUBO matrix density depends on coalition overlap patterns.}}{86}{table.caption.52}\protected@file@percent }
\newlabel{tab:4-7}{{9.8}{86}{\textbf {Table 4.7: Scalability Analysis.} Problem size grows combinatorially: 3 robots + 2 tasks = 7 MWIS nodes, 18 conflict edges. OIM hardware depth scales linearly with spin count. QUBO matrix density depends on coalition overlap patterns}{table.caption.52}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9.9}{\ignorespaces \textbf  {Table 4.8: OIM Pipeline Timing.} Execution stages for task allocation pipeline on neuromorphic hardware. Graph construction (coalition enumeration + conflict identification) dominates pre-computation. OIM solver convergence (37\% success rate in simulation) depends on initial conditions and problem structure.}}{86}{table.caption.53}\protected@file@percent }
\newlabel{tab:4-8}{{9.9}{86}{\textbf {Table 4.8: OIM Pipeline Timing.} Execution stages for task allocation pipeline on neuromorphic hardware. Graph construction (coalition enumeration + conflict identification) dominates pre-computation. OIM solver convergence (37\% success rate in simulation) depends on initial conditions and problem structure}{table.caption.53}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9.10}{\ignorespaces \textbf  {Table 5.1: 2-DOF Arm System Parameters.} Balanced planar arm with equal link lengths and masses. Gravity $g = 9.81$ m/s$^2$. Dynamics governed by Lagrangian $\mathcal  {L} = T - V$.}}{86}{table.caption.54}\protected@file@percent }
\newlabel{tab:5-1}{{9.10}{86}{\textbf {Table 5.1: 2-DOF Arm System Parameters.} Balanced planar arm with equal link lengths and masses. Gravity $g = 9.81$ m/s$^2$. Dynamics governed by Lagrangian $\mathcal {L} = T - V$}{table.caption.54}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9.11}{\ignorespaces \textbf  {Table 5.2: Inertia Matrix at Equilibrium.} Computed inertia matrix $\mathbf  {M}(\theta ^*)$ where $\theta ^* = (0.5, 0.5)$ rad. Entries computed from Lagrangian; positive-definite matrix ensures stable dynamics.}}{87}{table.caption.55}\protected@file@percent }
\newlabel{tab:5-2}{{9.11}{87}{\textbf {Table 5.2: Inertia Matrix at Equilibrium.} Computed inertia matrix $\mathbf {M}(\theta ^*)$ where $\theta ^* = (0.5, 0.5)$ rad. Entries computed from Lagrangian; positive-definite matrix ensures stable dynamics}{table.caption.55}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9.12}{\ignorespaces \textbf  {Table 5.3: Linearized State-Space Matrices (3 Cases).} Linearization about equilibrium $\theta ^*$ yields continuous-time LTI system $\dot  {x} = A_c x + B_c u$. Control input $u_0$ from gravity compensation $G(\theta ^*) = M(\theta ^*) \ddot  {\theta }^*$ with $\ddot  {\theta }^* = 0$ at equilibrium.}}{87}{table.caption.56}\protected@file@percent }
\newlabel{tab:5-3}{{9.12}{87}{\textbf {Table 5.3: Linearized State-Space Matrices (3 Cases).} Linearization about equilibrium $\theta ^*$ yields continuous-time LTI system $\dot {x} = A_c x + B_c u$. Control input $u_0$ from gravity compensation $G(\theta ^*) = M(\theta ^*) \ddot {\theta }^*$ with $\ddot {\theta }^* = 0$ at equilibrium}{table.caption.56}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9.13}{\ignorespaces \textbf  {Table 5.4: Discrete State-Space Matrices (Case A, $\Delta t = 0.02$ s).} Forward Euler discretization: $x_{k+1} = A_d x_k + B_d u_k + d$ where $A_d = I + \Delta t A_c$, $B_d = \Delta t B_c$. Discretization error $\sim O(\Delta t^2)$ acceptable for MPC horizon $N = 4$ steps (80 ms total).}}{87}{table.caption.57}\protected@file@percent }
\newlabel{tab:5-4}{{9.13}{87}{\textbf {Table 5.4: Discrete State-Space Matrices (Case A, $\Delta t = 0.02$ s).} Forward Euler discretization: $x_{k+1} = A_d x_k + B_d u_k + d$ where $A_d = I + \Delta t A_c$, $B_d = \Delta t B_c$. Discretization error $\sim O(\Delta t^2)$ acceptable for MPC horizon $N = 4$ steps (80 ms total)}{table.caption.57}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9.14}{\ignorespaces \textbf  {Table 5.5: Quadratic Program Dimensions.} MPC QP problem size scales with prediction horizon $N$. For Case A: $n_x = 4$ states, $n_u = 2$ control inputs, QP variables: $N(n_x + n_u)$. With $N = 4$: 28 variables, condition number $\approx 100$.}}{87}{table.caption.58}\protected@file@percent }
\newlabel{tab:5-5}{{9.14}{87}{\textbf {Table 5.5: Quadratic Program Dimensions.} MPC QP problem size scales with prediction horizon $N$. For Case A: $n_x = 4$ states, $n_u = 2$ control inputs, QP variables: $N(n_x + n_u)$. With $N = 4$: 28 variables, condition number $\approx 100$}{table.caption.58}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9.15}{\ignorespaces \textbf  {Table 5.6: PIPG Solver Convergence.} Projected Implicit Gradient Descent with step size $\alpha = 0.001$ applied to QP from rest. Cost decreases monotonically; gradient norm decreases sub-linearly. After 5 iterations: final cost $J = -0.009955$, convergence rate $\approx -0.25$ (linear convergence).}}{88}{table.caption.59}\protected@file@percent }
\newlabel{tab:5-6}{{9.15}{88}{\textbf {Table 5.6: PIPG Solver Convergence.} Projected Implicit Gradient Descent with step size $\alpha = 0.001$ applied to QP from rest. Cost decreases monotonically; gradient norm decreases sub-linearly. After 5 iterations: final cost $J = -0.009955$, convergence rate $\approx -0.25$ (linear convergence)}{table.caption.59}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9.16}{\ignorespaces \textbf  {Table 5.7: Closed-Loop MPC Performance.} Simulation of Case A arm tracking target position $(0.5, 0.5)$ m under receding-horizon MPC control. Steady-state error measured at $t > 4$ s. Settling time (2\% criterion) $\approx 2.5$ s. Maximum joint torques remain within physical limits.}}{88}{table.caption.60}\protected@file@percent }
\newlabel{tab:5-7}{{9.16}{88}{\textbf {Table 5.7: Closed-Loop MPC Performance.} Simulation of Case A arm tracking target position $(0.5, 0.5)$ m under receding-horizon MPC control. Steady-state error measured at $t > 4$ s. Settling time (2\% criterion) $\approx 2.5$ s. Maximum joint torques remain within physical limits}{table.caption.60}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9.17}{\ignorespaces \textbf  {Table 6.1: MRTA Solver Performance.} Benchmark on 5R3T problems (3 instances). Greedy finds best utility (5.94$\pm $0.82) in <1 ms. Simulated annealing slower (101 ms) with worse utility. OIM failed to converge (0 utility) due to parameter tuning needed. Exact solver provides ground truth.}}{88}{table.caption.61}\protected@file@percent }
\newlabel{tab:6-1}{{9.17}{88}{\textbf {Table 6.1: MRTA Solver Performance.} Benchmark on 5R3T problems (3 instances). Greedy finds best utility (5.94$\pm $0.82) in <1 ms. Simulated annealing slower (101 ms) with worse utility. OIM failed to converge (0 utility) due to parameter tuning needed. Exact solver provides ground truth}{table.caption.61}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9.18}{\ignorespaces \textbf  {Table 6.2: Linearization Error Analysis.} Linearization accuracy tested at Case A equilibrium for perturbations of increasing magnitude. Linearization error grows as $O(\|\Delta \theta \|^2)$. Below 0.1 rad, error <2\%, acceptable for MPC linearization within receding horizon.}}{88}{table.caption.62}\protected@file@percent }
\newlabel{tab:6-2}{{9.18}{88}{\textbf {Table 6.2: Linearization Error Analysis.} Linearization accuracy tested at Case A equilibrium for perturbations of increasing magnitude. Linearization error grows as $O(\|\Delta \theta \|^2)$. Below 0.1 rad, error <2\%, acceptable for MPC linearization within receding horizon}{table.caption.62}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9.19}{\ignorespaces \textbf  {Table 6.3: QP Solver Performance.} Closed-loop MPC comparing OSQP (active-set, commercial solver) versus PIPG (gradient-based, neuromorphic-ready). OSQP faster per solve (8.2 ms) but PIPG suitable for neuromorphic hardware (Loihi, GPU) with comparable control performance.}}{89}{table.caption.63}\protected@file@percent }
\newlabel{tab:6-3}{{9.19}{89}{\textbf {Table 6.3: QP Solver Performance.} Closed-loop MPC comparing OSQP (active-set, commercial solver) versus PIPG (gradient-based, neuromorphic-ready). OSQP faster per solve (8.2 ms) but PIPG suitable for neuromorphic hardware (Loihi, GPU) with comparable control performance}{table.caption.63}{}}
