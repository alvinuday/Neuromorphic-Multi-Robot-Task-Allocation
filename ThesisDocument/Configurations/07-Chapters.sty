%%% Chapters and Sections %%%
\ifthenelse{\equal{\ChapterOption}{classic}}{
    \titleformat{\chapter}[display]%
    {\raggedleft\huge}%
    {\raggedleft\fontsize{72}{10}\bfseries{\color{chapterdarkred}{\thechapter}}}%
    {-15pt}%
    {\hspace{3cm}\minionfont\fontsize{28}{30}\selectfont}%
    \titlespacing*{\chapter}{0pt}{40pt}{30pt}%
}{}

\ifthenelse{\equal{\ChapterOption}{fancy}}{
    \titleformat{\chapter}[display]
    {\flushright\normalsize\huge\color{black}}%
    {\flushright\normalsize%
    {\fontsize{25}{25}\selectfont\hspace*{-1em}\rule[-2pt]{.1pt}{30pt}\hspace{0.5em}\raisebox{4.5pt}{\thechapter}}}%
    {10pt}%
    {\addfontfeature{LetterSpace=6}\huge\scshape}%
}{}

\ifthenelse{\equal{\ChapterOption}{modern}}{
    \titleformat{\chapter}[display]
    {\normalsize\huge\color{black}}%
    {\minionfont\flushright\fontsize{84}{10}\bfseries%
    {\color{chaptergray}\raisebox{5pt}{\thechapter}}%
    }{10pt}%
    {\minionfont\addfontfeature{LetterSpace=6}\fontsize{28}{32}\MakeUppercase}%
}{}

\titleformat{\section}{\minionfont\fontsize{16pt}{19pt}\selectfont\bfseries\color{chapterdarkred}}{\thesection}{0.8em}{}
\titlespacing*{\section}{0pt}{18pt}{12pt}

\titleformat{\subsection}{\minionfont\fontsize{13.5pt}{15.5pt}\selectfont\bfseries}{\thesubsection}{0.8em}{}
\titlespacing*{\subsection}{0pt}{14pt}{8pt}

\titleformat{\subsubsection}{\minionfont\fontsize{12pt}{14pt}\selectfont\bfseries\itshape}{\thesubsubsection}{0.8em}{}
\titlespacing*{\subsubsection}{0pt}{10pt}{6pt}